{
  "name": "omp-gateway",
  "version": "0.3.0",
  "description": "omp extension: log in to any base-URL + API-key model gateway (CLIProxyAPI, LiteLLM, one-api, Volcengine Ark coding plan, …) and expose every chat model it serves",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "magic3007",
  "homepage": "https://github.com/magic3007/omp-gateway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magic3007/omp-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/magic3007/omp-gateway/issues"
  },
  "keywords": [
    "omp",
    "omp-plugin",
    "oh-my-pi",
    "pi-coding-agent",
    "cliproxyapi",
    "llm-api-gateway",
    "model-provider",
    "login"
  ],
  "files": [
    "src",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.10.4",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "omp": {
    "name": "Gateway Login",
    "description": "Adds a '/login' entry that registers any base-URL + API-key model gateway (name, URL, key or key reference) and discovers its chat models.",
    "extensions": [
      "src/index.ts"
    ]
  }
